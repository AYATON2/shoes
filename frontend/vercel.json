{
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://shoes-production-04ab.up.railway.app/api/$1"
    },
    {
      "source": "/sanctum/csrf-cookie",
      "destination": "https://shoes-production-04ab.up.railway.app/sanctum/csrf-cookie"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
